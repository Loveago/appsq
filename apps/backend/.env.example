PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://mindora_user:mindora_password@localhost:5432/mindora_db?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET=super_secret_mindora_jwt_key_2026
JWT_REFRESH_SECRET=super_secret_mindora_refresh_key_2026
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_PROVIDER=openai
FREE_TIER_AI_MODEL=gpt-4o-mini
PRO_TIER_AI_MODEL=gpt-4o

# Audio & S3 Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_password
STORAGE_BUCKET_NAME=mindora-recordings

# RevenueCat & Billing
REVENUECAT_WEBHOOK_AUTH_TOKEN=your_revenuecat_secret
